{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkim-site",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
